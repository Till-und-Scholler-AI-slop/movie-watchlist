# TMDB API key (free at https://www.themoviedb.org/settings/api)
# Optional: without it, search uses a built-in demo catalog (30 movies).
TMDB_API_KEY=

# Server
PORT=8787

# --- Multi-User (Authentik) ---
# Trust X-authentik-* headers sent by the reverse proxy. Leave empty for local
# dev (a fixed "local" user is used — app stays single-user). Set to "1" only
# behind nginx + Authentik forward-auth, with the port bound to 127.0.0.1.
TRUST_AUTHENTIK_HEADERS=

# Optional shared secret for defense-in-depth: if set (and TRUST=1), nginx must
# forward the same value in X-Authentik-Secret. Blocks header spoofing if the
# port is ever accidentally exposed. Generate with: openssl rand -hex 32
AUTHENTIK_SHARED_SECRET=

# One-time migration: assign existing (pre-multi-user) watchlist rows to this
# Authentik uid. Leave empty in dev. After migration, this can be removed.
MIGRATE_LEGACY_OWNER_UID=
